{
  "name": "gemmanti",
  "private": true,
  "description": "Gemmanti build: compiles learn/*.jsx to plain JavaScript in learn/dist/ so the browser does not have to.",
  "scripts": {
    "build": "babel learn --only \"learn/*.jsx\" --out-dir learn/dist --out-file-extension .js --no-babelrc --presets @babel/preset-react"
  },
  "devDependencies": {
    "@babel/cli": "7.26.4",
    "@babel/core": "7.26.0",
    "@babel/preset-react": "7.26.3"
  }
}
